NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

MAX_UPLOAD_BYTES=536870912
UPLOAD_TTL_MINUTES=60
UPLOAD_CLEANUP_INTERVAL_MINUTES=10

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=streamweaver
MONGODB_COLLECTION=ingested_rows
MONGODB_BATCH_SIZE=5000
